+def _checker_score(circles, quad):
+    """How well the checkers measure the quad: each circle inside it counts as much as its
+    radius matches the one expected from the quad's width at its row (a checker is a point's
+    width, and a row of the playing area some RATIO checkers wide); one circle per spot."""
+    if not circles:
+        return 0.0
+    H = exact.homography(np.float64(quad), np.float64([(0, 0), (1, 0), (1, 1), (0, 1)]))
+    if H is None:
+        return 0.0
+    c = np.float64(circles)
+    uv = exact.apply_h(H, c[:, :2])
+    inside = (uv[:, 0] > 0) & (uv[:, 0] < 1) & (uv[:, 1] > 0) & (uv[:, 1] < 1)
+    if not inside.any():
+        return 0.0
+    c, u, v = c[inside], uv[inside, 0], uv[inside, 1]
+    Hi = exact.inv3(H)
+    left = exact.apply_h(Hi, np.stack([np.zeros_like(v), v], 1))
+    right = exact.apply_h(Hi, np.stack([np.ones_like(v), v], 1))
+    expected = np.sqrt(((right - left) ** 2).sum(1)) / RATIO / 2
+    t = c[:, 2] / expected
+    t = np.where(t >= 1, t, 1 / np.where(t > 0, t, 1e-9))
+    wt = np.maximum(0.0, 1 - (t - 1) / R_TOL)
+    # checkers stand on the points: their centres half a point from a point's edge, counted
+    # from the left edge in the left half and from the right edge in the right one
+    x = np.where(u < 0.5, u, 1 - u) * RATIO
+    off = np.abs(x - np.floor(x) - 0.5)
+    wt = wt * np.maximum(0.0, 1 - off / COL_TOL) * (x < 6.3)
+    taken, score = [], 0.0
+    for i in np.lexsort((c[:, 1], c[:, 0], -wt)):
+        if wt[i] <= 0:
+            break
+        x, y, e = c[i, 0], c[i, 1], expected[i]
+        if all((x - u) ** 2 + (y - q) ** 2 > (0.6 * e) ** 2 for u, q in taken):
+            taken.append((x, y))
+            score += float(wt[i])
+    return score
 
 
